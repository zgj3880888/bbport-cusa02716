+    if (!fault_guest_word((uint64_t)(uintptr_t)image + ELSEQ_MANAGER_OFFSET, &manager) || !manager)
+        return;
+    if (!fault_guest_word(manager + 0x30, &head) || !fault_guest_word(manager + 0x38, &tail)) return;
+    fault_guest_read((uintptr_t)(manager + 0x20), &last, 4);
+    size_t n = (size_t)snprintf(line, sizeof(line), "elSeq manager: %ld players, last id %u",
+                                tail > head ? (long)((tail - head) / 8) : 0,
+                                (unsigned)(last & 0xffffffffu));
+    fault_line(line, n);
+    for (int i = 0; i < ELSEQ_PRINTED && head + (uint64_t)i * 8 < tail; ++i) {
+        uint64_t player = 0, resource = 0, sequence = 0, flags = 0, id = 0;
+        if (!fault_guest_word(head + (uint64_t)i * 8, &player)) break;
+        if (!player) {
+            written_ = write(2, "  player: (null element)\n", 25);
+            (void)written_;
+            continue;
+        }
+        fault_guest_word(player + 0xe0, &resource);
+        fault_guest_word(player + 0xe8, &sequence);
+        if (resource) fault_guest_read((uintptr_t)(resource + 0x20), &flags, 4);
+        if (sequence) fault_guest_read((uintptr_t)(sequence + 0x108), &id, 4);
+        n = (size_t)snprintf(line, sizeof(line),
+                             "  player %#018lx: resource %#018lx flags %#010lx elSeq %#018lx id %u%s",
+                             (unsigned long)player, (unsigned long)resource, (unsigned long)flags,
+                             (unsigned long)sequence, sequence ? (unsigned)id : 0,
+                             sequence ? "" : " <<< no elSeq: the walk dereferences 0x108 here");
+        fault_line(line, n);
+        /* The resource's name, wherever the class keeps it: printable strings its first words
+         * point at. A resource that failed to load usually still holds the name it was asked
+         * for, which is what says which file to look at. */
+        int shown = 0;
+        for (int off = 0; resource && off <= 0x100 && shown < 2; off += 8) {
+            uint64_t value = 0;
+            if (!fault_guest_word(resource + (uint64_t)off, &value) || !value) continue;
+            if (!fault_text_at(value, text, sizeof(text))) continue;
+            n = (size_t)snprintf(line, sizeof(line), "    resource + %#04x -> \"%s\"", off, text);
+            fault_line(line, n);
+            ++shown;
+        }
+        /* The broken resource's own bytes, and one healthy one beside them as the reference
+         * of what a resource that loaded looks like. Capped: a run that fails every load would
+         * otherwise print a hexdump per player. */
+        if (resource && (sequence ? !dumped_healthy : broken_dumped < 3)) {
+            fault_dump_bytes("resource", resource, 0x50);
+            if (sequence) dumped_healthy = 1; else ++broken_dumped;
+        }
+    }
+}
