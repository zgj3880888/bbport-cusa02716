+// SPDX-FileCopyrightText: Copyright 2024-2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: libkernel event flags. Ported from shadPS4 src/core/libraries/kernel/threads/
+// event_flag.cpp because this fork only carried the equeue half of the kernel's event
+// management, and CUSA02716 imports the event-flag half (sceKernelCreateEventFlag and its
+// 5 companions) from libkernel.
+
+#pragma once
+
+namespace Core::Loader {
+class SymbolsResolver;
+}
+
+namespace Libraries::Kernel {
+
+void RegisterKernelEventFlag(Core::Loader::SymbolsResolver* sym);
+
+} // namespace Libraries::Kernel
diff --git a/gpu/shadps4/core/libraries/zlib/sce_zlib.cpp b/gpu/shadps4/core/libraries/zlib/sce_zlib.cpp
new file mode 100644
index 0000000..5bd3124
--- /dev/null
+++ b/gpu/shadps4/core/libraries/zlib/sce_zlib.cpp
@@ -0,0 +1,228 @@
+// SPDX-FileCopyrightText: Copyright 2024-2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: ported from shadPS4 src/core/libraries/zlib/zlib.cpp.
+//
+// The library is asynchronous by contract: sceZlibInflate only queues the job and hands back a
+// request id, sceZlibWaitForDone blocks until some job finishes, and sceZlibGetResult reports
+// that job's outcome. One worker thread runs the jobs in order on miniz, which this build
+// already links for its texture cache.
+//
+// Differences from upstream: the worker is a plain std::thread with a stop flag instead of a
+// Kernel::Thread with stop tokens (this fork has no guest scheduler to hang it off), so Finalize
+// joins it directly. The accounting counters are new, for runtime_report.
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <mutex>
+#include <queue>
+#include <thread>
+#include <unordered_map>
+
+#include <miniz.h>
+
+#include "common/logging/log.h"
+#include "common/thread.h"
+#include "common/types.h"
+#include "core/libraries/error_codes.h"
+#include "core/libraries/libs.h"
+#include "core/libraries/zlib/sce_zlib.h"
+
+namespace Libraries::Zlib {
+
+namespace {
+
+struct InflateTask {
+    u64 request_id;
+    const void* src;
+    u32 src_length;
+    void* dst;
+    u32 dst_length;
+};
+
+struct InflateResult {
+    u32 length;
+    s32 status;
+};
+
+std::mutex g_mutex;
+std::condition_variable g_task_cv;
+std::condition_variable g_done_cv;
+std::queue<InflateTask> g_task_queue;
+std::queue<u64> g_done_queue;
+std::unordered_map<u64, InflateResult> g_results;
+u64 g_next_request_id = 1;
+bool g_stop = false;
+std::thread g_worker;
+
+// Diagnostics only; read without the lock in the report.
+std::atomic<u64> g_jobs{0};
+std::atomic<u64> g_failures{0};
+std::atomic<u64> g_bytes_out{0};
+
+bool WorkerRunning() {
+    return g_worker.joinable();
+}
+
+void ZlibTaskThread() {
+    Common::SetCurrentThreadName("bb:ZlibTaskThread");
+
+    for (;;) {
+        InflateTask task;
+        {
+            std::unique_lock lock{g_mutex};
+            g_task_cv.wait(lock, [] { return g_stop || !g_task_queue.empty(); });
+            if (g_task_queue.empty()) {
+                return; // stop requested and nothing left to do
+            }
+            task = g_task_queue.front();
+            g_task_queue.pop();
+        }
+
+        // mz_uncompress wants the zlib-wrapped stream the PS4 library is given, not raw deflate.
+        mz_ulong decompressed_length = task.dst_length;
+        const int ret = mz_uncompress(static_cast<u8*>(task.dst), &decompressed_length,
+                                      static_cast<const u8*>(task.src), task.src_length);
+
+        const s32 status = ret == MZ_BUF_ERROR ? ORBIS_ZLIB_ERROR_NOSPACE
+                           : ret == MZ_OK      ? ORBIS_OK
+                                               : ORBIS_ZLIB_ERROR_FATAL;
+        if (status != ORBIS_OK) {
+            ++g_failures;
+        } else {
+            g_bytes_out += decompressed_length;
+        }
+        ++g_jobs;
+
+        {
+            std::lock_guard lock{g_mutex};
+            g_results[task.request_id] =
+                InflateResult{.length = static_cast<u32>(decompressed_length), .status = status};
+            g_done_queue.push(task.request_id);
+        }
+        g_done_cv.notify_one();
+    }
+}
+
+} // namespace
+
+s32 PS4_SYSV_ABI sceZlibInitialize(const void* buffer, u32 length) {
+    LOG_INFO(Lib_Zlib, "called buffer = {}, length = {}", static_cast<const void*>(buffer), length);
+    if (WorkerRunning()) {
+        return ORBIS_ZLIB_ERROR_ALREADY_INITIALIZED;
+    }
+
+    {
+        std::lock_guard lock{g_mutex};
+        g_task_queue = std::queue<InflateTask>();
+        g_done_queue = std::queue<u64>();
+        g_results.clear();
+        g_next_request_id = 1;
+        g_stop = false;
+    }
+
+    g_worker = std::thread{ZlibTaskThread};
+    return ORBIS_OK;
+}
+
+s32 PS4_SYSV_ABI sceZlibInflate(const void* src, u32 src_len, void* dst, u32 dst_len,
+                                u64* request_id) {
+    LOG_DEBUG(Lib_Zlib, "called src_len = {}, dst_len = {}", src_len, dst_len);
+    if (!WorkerRunning()) {
+        return ORBIS_ZLIB_ERROR_NOT_INITIALIZED;
+    }
+    if (!src || !src_len || !dst || !dst_len || !request_id || dst_len > 64_KB ||
+        dst_len % 2_KB != 0) {
+        return ORBIS_ZLIB_ERROR_INVALID;
+    }
+
+    std::lock_guard lock{g_mutex};
+    *request_id = g_next_request_id++;
+    g_task_queue.push(InflateTask{
+        .request_id = *request_id,
+        .src = src,
+        .src_length = src_len,
+        .dst = dst,
+        .dst_length = dst_len,
+    });
+    g_task_cv.notify_one();
+    return ORBIS_OK;
+}
+
+s32 PS4_SYSV_ABI sceZlibWaitForDone(u64* request_id, const u32* timeout) {
+    LOG_DEBUG(Lib_Zlib, "called");
+    if (!WorkerRunning()) {
+        return ORBIS_ZLIB_ERROR_NOT_INITIALIZED;
+    }
+    if (!request_id) {
+        return ORBIS_ZLIB_ERROR_INVALID;
+    }
+
+    std::unique_lock lock{g_mutex};
+    const auto done = [] { return !g_done_queue.empty(); };
+    if (timeout) {
+        if (!g_done_cv.wait_for(lock, std::chrono::milliseconds(*timeout), done)) {
+            return ORBIS_ZLIB_ERROR_TIMEDOUT;
+        }
+    } else {
+        g_done_cv.wait(lock, done);
+    }
+    *request_id = g_done_queue.front();
+    g_done_queue.pop();
+    return ORBIS_OK;
+}
+
+s32 PS4_SYSV_ABI sceZlibGetResult(u64 request_id, u32* dst_length, s32* status) {
+    LOG_DEBUG(Lib_Zlib, "called request_id = {}", request_id);
+    if (!WorkerRunning()) {
+        return ORBIS_ZLIB_ERROR_NOT_INITIALIZED;
+    }
+    if (!dst_length || !status) {
+        return ORBIS_ZLIB_ERROR_INVALID;
+    }
+
+    std::lock_guard lock{g_mutex};
+    const auto it = g_results.find(request_id);
+    if (it == g_results.end()) {
+        return ORBIS_ZLIB_ERROR_NOT_FOUND;
+    }
+    *dst_length = it->second.length;
+    *status = it->second.status;
+    return ORBIS_OK;
+}
+
+s32 PS4_SYSV_ABI sceZlibFinalize() {
+    LOG_INFO(Lib_Zlib, "called");
+    if (!WorkerRunning()) {
+        return ORBIS_ZLIB_ERROR_NOT_INITIALIZED;
+    }
+
+    {
+        std::lock_guard lock{g_mutex};
+        g_stop = true;
+    }
+    g_task_cv.notify_all();
+    g_worker.join();
+
+    std::lock_guard lock{g_mutex};
+    g_task_queue = std::queue<InflateTask>();
+    g_done_queue = std::queue<u64>();
+    g_results.clear();
+    return ORBIS_OK;
+}
+
+void Report() {
+    LOG_INFO(Lib_Zlib, "jobs = {}, failures = {}, bytes out = {}", g_jobs.load(),
+             g_failures.load(), g_bytes_out.load());
+}
+
+void RegisterLib(Core::Loader::SymbolsResolver* sym) {
+    LIB_FUNCTION("m1YErdIXCp4", "libSceZlib", 1, "libSceZlib", sceZlibInitialize);
+    LIB_FUNCTION("6na+Sa-B83w", "libSceZlib", 1, "libSceZlib", sceZlibFinalize);
+    LIB_FUNCTION("TLar1HULv1Q", "libSceZlib", 1, "libSceZlib", sceZlibInflate);
+    LIB_FUNCTION("uB8VlDD4e0s", "libSceZlib", 1, "libSceZlib", sceZlibWaitForDone);
+    LIB_FUNCTION("2eDcGHC0YaM", "libSceZlib", 1, "libSceZlib", sceZlibGetResult);
+}
+
+} // namespace Libraries::Zlib
