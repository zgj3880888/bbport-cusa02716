+void runtime_netnp_report(void) {
+    size_t total = 0;
+    for (int i = 0; i < G_GROUPS; ++i) total += netnp_binds[i];
+    if (!total) {
+        printf("Runtime: netnp: no import bound\n");
+        return;
+    }
+    printf("Runtime: netnp: %zu imports bound (", total);
+    int first = 1;
+    for (int i = 0; i < G_GROUPS; ++i) {
+        if (!netnp_binds[i]) continue;
+        printf("%s%s %zu", first ? "" : ", ", netnp_group_names[i], netnp_binds[i]);
+        first = 0;
+    }
+    printf(")\n");
+}
diff --git a/src/runtime_file.c b/src/runtime_file.c
index 38e4920..88bfff3 100644
--- a/src/runtime_file.c
+++ b/src/runtime_file.c
@@ -222,6 +222,32 @@
 static int audio_trace(void) { static int v=-1; if (v<0) { const char *e=getenv("BB_AUDIO_TRACE"); v=e && e[0]=='1'; } return v; }
 /* BB_SAVE_TRACE=1: every operation on save files (/savedataN). */
 static int save_trace(void) { static int v=-1; if (v<0) { const char *e=getenv("BB_SAVE_TRACE"); v=e && e[0]=='1'; } return v; }
+/* The guest paths opened last, oldest first, kept for a fault report. The resource a crash is
+ * about is nearly always read just before it, and a load that ends with the right number of
+ * bytes but the wrong content leaves no line of its own: the list of names is what says which
+ * file to look at. Written with write(2) because the fault handler prints it too, and it may
+ * run on a thread that held the stdio lock when it faulted. */
+#define FILE_RING 16
+static struct { char path[96]; int result; } file_ring[FILE_RING];
+static unsigned file_ring_writes;
+static void file_ring_add(const char *guest,int result) {
+    unsigned slot=__atomic_add_fetch(&file_ring_writes,1,__ATOMIC_RELAXED)%FILE_RING;
+    snprintf(file_ring[slot].path,sizeof(file_ring[slot].path),"%s",guest ? guest : "?");
+    file_ring[slot].result=result;
+}
+void runtime_file_trace_dump(void) {
+    char line[160];
+    unsigned total=__atomic_load_n(&file_ring_writes,__ATOMIC_RELAXED);
+    if (!total) return;
+    unsigned keep=total<FILE_RING ? total : FILE_RING;
+    int n=snprintf(line,sizeof(line),"Files: the last %u opens, oldest first (fd, or -errno)\n",keep);
+    if (n>0 && write(2,line,(size_t)n) < 0) return;
+    for (unsigned i=0;i<keep;++i) {
+        unsigned slot=(total-keep+i)%FILE_RING;
+        n=snprintf(line,sizeof(line),"  %s -> %d\n",file_ring[slot].path,file_ring[slot].result);
+        if (n>0 && write(2,line,(size_t)n) < 0) return;
+    }
+}
 /* Game mounts (including linked mod overlays) are read-only. Saves use other mounts. */
 static int game_path(const char *p) {
     if (!p || !*p) return 0;
@@ -329,6 +355,7 @@
     if (host<0) {
         e=errno;
         if (e==ENOENT) { ++missing; printf("Runtime: open(%s) -> not found\n",guest); }
+        file_ring_add(guest,-e);
         return -e;
     }
     struct stat s;
@@ -359,6 +386,7 @@
         }
     }
     if (save_trace() && save_path(guest)) printf("Save trace: open(%s) -> fd %d\n",guest,fd);
+    file_ring_add(guest,fd);
     return fd;
 }
