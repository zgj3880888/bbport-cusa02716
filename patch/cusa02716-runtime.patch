+/* --- Date/time string parsing (CUSA02716 imports these from libSceRtc) --- */
+/* Reads `count` decimal digits at s; 0 when one is not a digit. */
+static int take_digits(const char *s,int count,int *out) {
+    int value=0;
+    for (int i=0;i<count;++i) {
+        if (s[i]<'0' || s[i]>'9') return 0;
+        value=value*10+(s[i]-'0');
+    }
+    *out=value;
+    return 1;
+}
+/* Fractional-second digits starting at s (after the '.'): scaled to microseconds. */
+static int take_fraction(const char *s,uint32_t *micros) {
+    uint32_t value=0;
+    int digits=0, scale=100000;
+    while (digits<6 && s[digits]>='0' && s[digits]<='9') {
+        value+=(uint32_t)(s[digits]-'0')*scale;
