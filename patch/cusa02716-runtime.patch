+    }
     runtime_net_image_mapped(image, size); /* online modules that read the original code */
     for (int i=0;i<patch_count;++i) apply_patches(patch_files[i], segments, ns, relocs, nr);
     if (!cpu_only) {
diff --git a/src/runtime_dialogs.c b/src/runtime_dialogs.c
new file mode 100644
index 0000000..ea60353
--- /dev/null
+++ b/src/runtime_dialogs.c
@@ -0,0 +1,196 @@
+/* The on-screen dialogs and the on-screen keyboard: the thirty imports CUSA02716 makes of
+ * libSceIme, libSceErrorDialog, libSceMsgDialog, libSceSaveDataDialog, libSceSigninDialog and
+ * libSceInvitationDialog.
+ *
+ * There is no dialog to show on a phone and nobody to answer one, so every dialog is reported as
+ * having finished the moment it is opened: UpdateStatus answers FINISHED (3), GetResult hands back
+ * a zeroed result (CommonDialog::Result::OK) and IsReadyToDisplay answers 1. A caller that opens a
+ * dialog and then polls for FINISHED goes on at once instead of waiting for an answer that would
+ * never come. That is also the answer the hardware library gives when the dialog is dismissed
+ * without a choice, which is why these entry points can share one shape.
+ *
+ * The result structures are zeroed to the size the PS4 SDK gives them (OrbisMsgDialogResult 16,
+ * OrbisSaveDataDialogResult 72, OrbisSigninDialogResult 16, OrbisInvitationDialogResult 56,
+ * OrbisImeKeyboardResourceIdArray 24, OrbisImeKeyboardInfo 32) - never more, so a caller's
+ * neighbouring bytes are untouched.
+ *
+ * The IME is treated the same way: the keyboard opens and reports no input. sceImeUpdate hands the
+ * game no event, so whatever polls it sees an idle keyboard rather than one that never answers. */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* CommonDialog::Status (system/commondialog.h): the value UpdateStatus and GetStatus return. */
+enum { DIALOG_NONE = 0, DIALOG_INITIALIZED = 1, DIALOG_RUNNING = 2, DIALOG_FINISHED = 3 };
+
+static pthread_mutex_t dialog_lock = PTHREAD_MUTEX_INITIALIZER;
+
+#define DIALOG_STATE(_cname) static int _cname##_state
+
+DIALOG_STATE(error);
+DIALOG_STATE(message);
+DIALOG_STATE(save_data);
+DIALOG_STATE(signin);
+DIALOG_STATE(invitation);
+static int keyboard_open;
+
+/* An entry point with no out-parameter: it succeeds and leaves the dialog finished. */
+#define DIALOG_ACCEPT(_cname, _name)                                       \
+    static ABI int32_t _name(uintptr_t argument0, uintptr_t argument1) {    \
+        (void)argument0;                                                   \
+        (void)argument1;                                                   \
+        pthread_mutex_lock(&dialog_lock);                                   \
+        _cname##_state = DIALOG_FINISHED;                                   \
+        pthread_mutex_unlock(&dialog_lock);                                 \
+        return 0;                                                           \
+    }
+
+/* The same, but it does not start a dialog: a close or a terminate. */
+#define DIALOG_PLAIN(_name)                                                \
+    static ABI int32_t _name(uintptr_t argument0, uintptr_t argument1) {    \
+        (void)argument0;                                                    \
+        (void)argument1;                                                    \
+        return 0;                                                           \
+    }
+
+/* UpdateStatus / GetStatus: what the caller polls after opening the dialog. */
+#define DIALOG_STATUS(_cname, _name)                                       \
+    static ABI int32_t _name(void) {                                        \
+        int32_t status;                                                     \
+        pthread_mutex_lock(&dialog_lock);                                   \
+        status = _cname##_state;                                            \
+        pthread_mutex_unlock(&dialog_lock);                                 \
+        return status;                                                      \
+    }
+
+/* GetResult: a zeroed result of `size` bytes, which is CommonDialog::Result::OK. */
+#define DIALOG_RESULT(_name, _size)                                        \
+    static ABI int32_t _name(void *result) {                                \
+        if (result) memset(result, 0, (_size));                             \
+        return 0;                                                           \
+    }
+
+/* libSceErrorDialog -------------------------------------------------------------------------- */
+DIALOG_ACCEPT(error, error_dialog_initialize)   /* sceErrorDialogInitialize(void) */
+DIALOG_ACCEPT(error, error_dialog_open)         /* sceErrorDialogOpen(const OrbisErrorDialogParam*) */
+DIALOG_PLAIN(error_dialog_close)                /* sceErrorDialogClose(void) */
+DIALOG_STATUS(error, error_dialog_update_status) /* sceErrorDialogUpdateStatus(void) */
+DIALOG_PLAIN(error_dialog_terminate)            /* sceErrorDialogTerminate(void) */
+
+/* libSceMsgDialog ---------------------------------------------------------------------------- */
+DIALOG_PLAIN(msg_dialog_progress_inc)       /* sceMsgDialogProgressBarInc(target, delta) */
+DIALOG_PLAIN(msg_dialog_progress_set_value) /* sceMsgDialogProgressBarSetValue(target, rate) */
+DIALOG_PLAIN(msg_dialog_progress_set_msg)   /* sceMsgDialogProgressBarSetMsg(target, const char*) */
+DIALOG_PLAIN(msg_dialog_close)              /* sceMsgDialogClose(void) */
+DIALOG_RESULT(msg_dialog_get_result, 16)    /* sceMsgDialogGetResult(OrbisMsgDialogResult*) */
+
+/* libSceSaveDataDialog ---------------------------------------------------------------------- */
+DIALOG_STATUS(save_data, save_data_dialog_get_status) /* sceSaveDataDialogGetStatus(void) */
+DIALOG_RESULT(save_data_dialog_get_result, 72)        /* sceSaveDataDialogGetResult(..Result*) */
+DIALOG_PLAIN(save_data_dialog_close)                  /* sceSaveDataDialogClose(void) */
+/* 1: the dialog can be drawn. Without a dialog to draw, answering 0 would leave a caller that
+ * waits for the display spinning. */
+static ABI int32_t save_data_dialog_is_ready_to_display(void) { return 1; }
+
+/* libSceSigninDialog ------------------------------------------------------------------------ */
+DIALOG_ACCEPT(signin, signin_dialog_initialize) /* sceSigninDialogInitialize(void) */
+DIALOG_ACCEPT(signin, signin_dialog_open)       /* sceSigninDialogOpen(const OrbisSigninDialogParam*) */
+DIALOG_PLAIN(signin_dialog_terminate)           /* sceSigninDialogTerminate(void) */
+DIALOG_STATUS(signin, signin_dialog_update_status) /* sceSigninDialogUpdateStatus(void) */
+DIALOG_RESULT(signin_dialog_get_result, 16)     /* sceSigninDialogGetResult(OrbisSigninDialogResult*) */
+DIALOG_PLAIN(signin_dialog_close)               /* sceSigninDialogClose(void) */
+
+/* libSceInvitationDialog -------------------------------------------------------------------- */
+DIALOG_ACCEPT(invitation, invitation_dialog_initialize) /* sceInvitationDialogInitialize(void) */
+DIALOG_ACCEPT(invitation, invitation_dialog_open)       /* sceInvitationDialogOpen(const ..Param*) */
+DIALOG_PLAIN(invitation_dialog_terminate)               /* sceInvitationDialogTerminate(void) */
+DIALOG_STATUS(invitation, invitation_dialog_update_status) /* sceInvitationDialogUpdateStatus(void) */
+DIALOG_RESULT(invitation_dialog_get_result, 56) /* sceInvitationDialogGetResult(..Result*) */
+
+/* libSceIme --------------------------------------------------------------------------------- */
+static ABI int32_t ime_keyboard_open(uintptr_t user_id, uintptr_t param) {
+    (void)user_id;
+    (void)param;
+    pthread_mutex_lock(&dialog_lock);
+    keyboard_open = 1;
+    pthread_mutex_unlock(&dialog_lock);
+    return 0;
+}
+static ABI int32_t ime_keyboard_close(uintptr_t user_id, uintptr_t argument1) {
+    (void)user_id;
+    (void)argument1;
+    pthread_mutex_lock(&dialog_lock);
+    keyboard_open = 0;
+    pthread_mutex_unlock(&dialog_lock);
+    return 0;
+}
+/* No event to hand the game: an idle keyboard, not one that never answers. */
+static ABI int32_t ime_update(uintptr_t handler, uintptr_t argument1) {
+    (void)handler;
+    (void)argument1;
+    return 0;
+}
+/* OrbisImeKeyboardResourceIdArray is 24 bytes: user_id then five resource ids. */
+static ABI int32_t ime_keyboard_get_resource_id(uintptr_t user_id, void *array) {
+    (void)user_id;
+    if (array) memset(array, 0, 24);
+    return 0;
+}
+/* OrbisImeKeyboardInfo is 32 bytes. */
+static ABI int32_t ime_keyboard_get_info(uintptr_t resource_id, void *info) {
+    (void)resource_id;
