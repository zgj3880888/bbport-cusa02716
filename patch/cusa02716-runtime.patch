+/* The network and PSN imports CUSA02716 makes that runtime_services.c cannot answer.
+ *
+ * runtime_services.c holds the offline contracts - cable unplugged, one local user who is logged in
+ * but signed out of PSN - and answers them by symbol name through runtime_symbol(). 169 of this
+ * title's 763 imports never reach those contracts: import_names.inc was generated from another
+ * title, has no entry for their NIDs, and runtime_symbol() then returns NULL, which no name-based
+ * table can match. This file binds them by NID instead (runtime_key_match compares the eleven NID
+ * characters only) and answers them with the same offline contract:
+ *
+ *   - sceNetCtlInit / sceNetCtlTerm succeed and sceNetCtlGetResult reports no error, which is what
+ *     the library answers with no cable plugged in; nothing is ever connected.
+ *   - Requests, contexts and handles are still handed out (an id from this file's own counter), so
+ *     a setup path runs to the end before the first call that needs PSN refuses it.
+ *   - Everything that needs PSN answers SCE_NP_ERROR_SIGNED_OUT (0x80550006), and *PollAsync
+ *     completes at once with that code, so the game's "PSN is unavailable" path runs rather than a
+ *     wait for a result that would never come.
+ *   - USB mass storage: no device is attached, so the device list is empty, IsExist answers 0 and
+ *     a map request answers ENOENT.
+ *   - sceHttpUriEscape is arithmetic, not a transfer, so it works exactly as the PS4's does.
+ *
+ * Sixty-two of these imports are libSceNpToolkit and five are libSceNpToolkitUtils - the game's own
+ * NP wrapper, whose thread the log names 'Toolkit::NP'. No symbol list names them (they are not in
+ * import_names.inc, and the upstream tree has no such library), so they get the library's own
+ * offline answer, SCE_NP_ERROR_SIGNED_OUT. Eight imports of two dialog libraries are deliberately
+ * left unbound: a dialog's UpdateStatus that answers NONE instead of FINISHED would leave a caller
+ * waiting for a dialog that can never finish, and probe.c's clean stop for an import it cannot
+ * resolve is the better outcome. Neither library is touched at start-up - they are the USB storage
+ * dialog and the friend list dialog, both opened by the player from a menu.
+ *
+ * The counts are for the import list probe.c printed for the image built from this title: 169
+ * imports without an implementation, of which this file binds 160. */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* PS4 error codes (np_error.h, net_ctl_codes.h, http_error.h, usbd/usbstorage.cpp). */
+#define NP_SIGNED_OUT ((int32_t)0x80550006)
+#define NP_INVALID_ARGUMENT ((int32_t)0x80550003)
+#define NET_CTL_INVALID_ADDR ((int32_t)0x80412107)
+#define HTTP_INVALID_VALUE ((int32_t)0x804311fe)
+#define HTTP_OUT_OF_MEMORY ((int32_t)0x80431022)
+#define USB_STORAGE_INVAL ((int32_t)0x80f40002)
+#define USB_STORAGE_NOENT ((int32_t)0x80f40004)
+/* CommonDialog::Status (system/commondialog.h). */
+#define DIALOG_FINISHED 3
+
+static pthread_mutex_t netnp_lock = PTHREAD_MUTEX_INITIALIZER;
+static int netnp_next_id = 1;
+
+/* ---- The contracts ---- */
+
+/* An entry point with no out-parameter that only has to be accepted: Terminate, Delete, Abort,
+ * Unregister, Destroy, and the Initialize calls that must succeed for setup to go on. */
+static ABI int32_t np_ok(void) { return 0; }
+
+/* Everything that needs PSN. The console is signed out, so this is the answer the library gives. */
+static ABI int32_t np_signed_out(void) { return NP_SIGNED_OUT; }
+
+/* A context, request or handle id: 1, 2, 3 ... The ids are only ever echoed back to this file's
+ * own entry points, which accept any of them, so they identify nothing beyond the log. */
+static ABI int32_t np_new_id(void) {
+    pthread_mutex_lock(&netnp_lock);
+    int id = netnp_next_id++;
+    pthread_mutex_unlock(&netnp_lock);
+    return id;
+}
+
+/* *PollAsync: the operation has finished and it failed. Returning "still in flight" here would
+ * leave the caller polling forever. */
+static ABI int32_t np_poll(int32_t request, int32_t *result) {
+    (void)request;
+    if (!result) return NP_INVALID_ARGUMENT;
+    *result = NP_SIGNED_OUT;
+    return 0;
+}
+
+/* A dialog's UpdateStatus: as in runtime_dialogs.c, the dialog has already finished. */
+static ABI int32_t np_dialog_finished(void) { return DIALOG_FINISHED; }
+
+/* OrbisNpCommerceDialogResult: 0x30 bytes (np/np_commerce/np_commerce.h), zeroed, which reads as
+ * result = ORBIS_COMMON_DIALOG_RESULT_OK and authorized = false - the answer for a store dialog
+ * nobody opened. */
+static ABI int32_t np_commerce_result(void *result) {
+    if (!result) return NP_INVALID_ARGUMENT;
+    memset(result, 0, 0x30);
+    return 0;
+}
+
+/* sceNetCtlGetResult(int eventType, int *errorCode): no connection attempt has been made, so the
+ * last result is "no error". */
+static ABI int32_t netctl_get_result(int32_t event, int32_t *error_code) {
+    (void)event;
+    if (!error_code) return NET_CTL_INVALID_ADDR;
+    *error_code = 0;
+    return 0;
+}
+
+/* sceHttpUriEscape(char *out, u64 *require, u64 prepare, const char *in): percent-encodes every
+ * byte that is not RFC 3986 unreserved. Pure arithmetic, so it does the real work: out == NULL
+ * (or a short buffer) is the size query the game makes before it allocates. */
+static ABI int32_t http_uri_escape(char *out, uint64_t *require, uint64_t prepare, const char *in) {
+    static const char hex[] = "0123456789ABCDEF";
+    if (!in) return HTTP_INVALID_VALUE;
+    uint64_t needed = 1; /* the terminator */
+    for (const char *s = in; *s; ++s) {
+        unsigned char c = (unsigned char)*s;
+        const int unreserved = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+                               (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~';
+        needed += unreserved ? 1 : 3;
+    }
+    if (require) *require = needed;
+    if (!out) return 0;
+    if (prepare < needed) return HTTP_OUT_OF_MEMORY;
+    char *dst = out;
+    for (const char *s = in; *s; ++s) {
+        unsigned char c = (unsigned char)*s;
+        const int unreserved = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+                               (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~';
+        if (unreserved) *dst++ = (char)c;
+        else { *dst++ = '%'; *dst++ = hex[(c >> 4) & 0xF]; *dst++ = hex[c & 0xF]; }
+    }
+    *dst = 0;
+    return 0;
+}
+
+/* ---- USB mass storage: no device is attached ---- */
+static ABI int32_t usb_unmap(uint32_t device, const char *directory) {
+    (void)device;
+    if (!directory) return USB_STORAGE_INVAL;
+    return 0;
+}
+static ABI int32_t usb_device_list(uint32_t *ids, uint32_t *count) {
+    if (!ids || !count) return USB_STORAGE_INVAL;
+    *count = 0;
+    return 0;
+}
+/* GetDeviceInfo and RequestMap: the device the caller names is not there. */
+static ABI int32_t usb_no_device(uint32_t device, void *info) {
+    (void)device;
+    if (!info) return USB_STORAGE_INVAL;
+    return USB_STORAGE_NOENT;
+}
+static ABI int32_t usb_is_exist(uint32_t device) { (void)device; return 0; }
+
+/* ---- libkernel / libc internals the guest's libc asks for ---- */
+/* __elf_phdr_match_addr(const void *info, void *address): the dl_iterate_phdr helper. Nothing
+ * enumerates phdrs here, so nothing matches. */
+static ABI int32_t k_phdr_match(const void *info, void *address) { (void)info; (void)address; return 0; }
+/* __pthread_cxa_finalize(void *dso): runs a DSO's destructors. There are none to run. */
+static ABI void k_cxa_finalize(void *dso) { (void)dso; }
+/* _is_signal_return: no frame of ours is a signal return frame. */
+static ABI int32_t k_is_signal_return(uintptr_t address) { (void)address; return 0; }
+/* sigreturn(const ucontext_t *): it cannot succeed from the guest, so it reports the failure the
+ * way the syscall does instead of pretending to have restored a context. */
+static ABI int32_t k_sigreturn(const void *context) { (void)context; return -1; }
+
+/* ---- Binding ---- */
+
+/* Every import this file answered, counted by group, for the report. Resolve runs once per import
+ * while the image is being relocated, so the counts describe what the image asked for. */
+enum { G_NETCTL, G_HTTP, G_NP, G_USB, G_AUDIODEC, G_KERNEL, G_GROUPS };
+static size_t netnp_binds[G_GROUPS];
+static const char *const netnp_group_names[G_GROUPS] = {
+    "netctl", "http", "np", "usb storage", "audiodec", "libkernel"};
+
+#define BIND(group, handler)                                                   \
+    do {                                                                       \
+        netnp_binds[group]++;                                                  \
+        return (uintptr_t)(handler);                                           \
+    } while (0)
