+    while (digits<6 && s[digits]>='0' && s[digits]<='9') {
+        value+=(uint32_t)(s[digits]-'0')*scale;
+        scale/=10; ++digits;
+    }
+    /* Digits past the sixth only matter for rounding, which a microsecond tick cannot show. */
