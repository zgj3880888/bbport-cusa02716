+        !take_digits(text+8,2,&day) || !take_digits(text+11,2,&hour) ||
+        !take_digits(text+14,2,&minute) || !take_digits(text+17,2,&second))
+        return (int32_t)0x80B50003; /* INVALID_VALUE */
