+    int32_t error;
+    int owned = 0, slot;
+    if (!out_handle) return ERR_INVALID_OUT_ADDRESS;
+    if (!option) return ERR_INVALID_OPTION_ADDRESS;
+    if (option->size < 32) return ERR_INVALID_OPTION_SIZE;
+    error = acquire_buffer(system_buffer_size(option), allocator, &buffer, &release, &owned);
+    if (error) return error;
+    pthread_mutex_lock(&table_lock);
+    slot = first_free(&systems[0].used, MAX_SYSTEMS, sizeof(Ngs2System));
+    if (slot < 0) {
+        pthread_mutex_unlock(&table_lock);
+        release_buffer(&buffer, release, owned, NULL);
+        return ERR_FAIL;
+    }
+    Ngs2System *system = &systems[slot];
+    memset(system, 0, sizeof(*system));
+    system->used = 1;
+    system->sample_rate = option->sample_rate ? option->sample_rate : 48000;
+    system->grain_samples = option->num_grain_samples ? option->num_grain_samples : 256;
+    system->max_grain_samples = option->max_grain_samples ? option->max_grain_samples : 512;
+    memcpy(system->name, option->name, 16);
+    system->name[16] = 0;
+    system->buffer = buffer;
+    system->host_free = release;
+    system->owns_buffer = owned;
+    *out_handle = MAKE_HANDLE(HANDLE_SYSTEM, slot);
+    systems_created++;
+    uint32_t sample_rate = system->sample_rate, grain = system->grain_samples,
+             max_grain = system->max_grain_samples;
+    uintptr_t handle_out = *out_handle;
+    pthread_mutex_unlock(&table_lock);
+    printf("Runtime: ngs2 system created (sampleRate=%u grainSamples=%u maxGrainSamples=%u "
+           "buffer=%zu bytes) handle=0x%llx\n",
+           sample_rate, grain, max_grain, buffer.host_buffer_size,
+           (unsigned long long)handle_out);
+    return 0;
+}
+static ABI int32_t ngs2_system_destroy(uintptr_t handle, Ngs2BufferInfo *out_buffer) {
+    Ngs2BufferHandler release = NULL;
+    Ngs2BufferInfo buffer;
+    int owned = 0;
+    pthread_mutex_lock(&table_lock);
+    Ngs2System *system = system_of(handle);
+    if (!system) {
+        pthread_mutex_unlock(&table_lock);
+        return ERR_INVALID_SYSTEM_HANDLE;
+    }
+    /* The racks and every voice handle of theirs go with the system that owns them. */
+    for (size_t i = 0; i < MAX_RACKS; ++i) {
+        if (!racks[i].used || racks[i].system != handle) continue;
+        uintptr_t rack_handle = MAKE_HANDLE(HANDLE_RACK, i);
+        for (size_t v = 0; v < MAX_VOICES; ++v)
+            if (voices[v].used && voices[v].rack == rack_handle) voices[v].used = 0;
+        racks[i].used = 0;
+    }
+    buffer = system->buffer;
+    release = system->host_free;
+    owned = system->owns_buffer;
+    memset(system, 0, sizeof(*system));
+    pthread_mutex_unlock(&table_lock);
+    release_buffer(&buffer, release, owned, out_buffer);
+    return 0;
+}
+static ABI int32_t ngs2_system_set_sample_rate(uintptr_t handle, uint32_t sample_rate) {
+    int32_t error = 0;
+    pthread_mutex_lock(&table_lock);
+    Ngs2System *system = system_of(handle);
+    if (system)
+        system->sample_rate = sample_rate ? sample_rate : system->sample_rate;
+    else
+        error = ERR_INVALID_SYSTEM_HANDLE;
+    pthread_mutex_unlock(&table_lock);
+    return error;
+}
+static ABI int32_t ngs2_system_set_grain_samples(uintptr_t handle, uint32_t num_samples) {
+    int32_t error = 0;
+    pthread_mutex_lock(&table_lock);
+    Ngs2System *system = system_of(handle);
+    if (system) {
+        if (num_samples) {
+            system->grain_samples = num_samples;
+            if (system->grain_samples > system->max_grain_samples)
+                system->max_grain_samples = system->grain_samples;
+        }
+    } else {
+        error = ERR_INVALID_SYSTEM_HANDLE;
+    }
+    pthread_mutex_unlock(&table_lock);
+    return error;
+}
+/* One grain of the graph. The graph produces silence: every output buffer is zeroed at the size the
+ * game gave it, which is what the audio port it feeds would otherwise repeat stale samples from. */
+static ABI int32_t ngs2_system_render(uintptr_t handle, const Ngs2RenderBuffer *buffers,
+                                      uint32_t num_buffers) {
+    int32_t error = 0;
+    pthread_mutex_lock(&table_lock);
+    Ngs2System *system = system_of(handle);
+    if (!system) {
+        pthread_mutex_unlock(&table_lock);
+        return ERR_INVALID_SYSTEM_HANDLE;
+    }
+    if (!buffers && num_buffers) {
+        render_errors++;
+        pthread_mutex_unlock(&table_lock);
+        return ERR_INVALID_OUT_ADDRESS;
+    }
+    for (uint32_t i = 0; i < num_buffers; ++i) {
+        size_t size = buffers[i].buffer_size;
+        if (!buffers[i].buffer) {
+            render_errors++;
+            continue;
+        }
+        if (!size) {
+            /* No size given: a grain of this system's format, the minimum the caller can want. */
+            size_t bytes = buffers[i].waveform_type == 0 ? 2 : 4;
+            size_t channels = buffers[i].num_channels ? buffers[i].num_channels : 1;
+            size = (size_t)system->grain_samples * channels * bytes;
+        }
+        if (size > MAX_ZERO_BYTES) size = MAX_ZERO_BYTES;
+        memset(buffers[i].buffer, 0, size);
+        if (i == 0) {
+            last_render_size = (uint32_t)(buffers[i].buffer_size > 0xffffffffu
+                                              ? 0xffffffffu
+                                              : buffers[i].buffer_size);
+            last_render_type = buffers[i].waveform_type;
+            last_render_channels = buffers[i].num_channels;
+        }
+    }
+    last_render_buffers = num_buffers;
+    render_calls++;
+    grains += num_buffers ? num_buffers : 1;
+    pthread_mutex_unlock(&table_lock);
+    return error;
+}
+
+static ABI int32_t ngs2_rack_create_with_allocator(uintptr_t system_handle, uint32_t rack_id,
+                                                   const Ngs2RackOption *option,
+                                                   const Ngs2Allocator *allocator, uintptr_t *out_handle) {
+    Ngs2BufferInfo buffer;
+    Ngs2BufferHandler release = NULL;
+    int32_t error;
+    int owned = 0, slot;
+    if (!out_handle) return ERR_INVALID_OUT_ADDRESS;
+    if (!option) return ERR_INVALID_OPTION_ADDRESS;
+    if (option->size < 40) return ERR_INVALID_OPTION_SIZE;
+    pthread_mutex_lock(&table_lock);
+    Ngs2System *system = system_of(system_handle);
+    pthread_mutex_unlock(&table_lock);
+    if (!system) return ERR_INVALID_SYSTEM_HANDLE;
+    error = acquire_buffer(rack_buffer_size(option), allocator, &buffer, &release, &owned);
+    if (error) return error;
+    pthread_mutex_lock(&table_lock);
+    slot = first_free(&racks[0].used, MAX_RACKS, sizeof(Ngs2Rack));
+    system = system_of(system_handle);
+    if (slot < 0 || !system) {
+        pthread_mutex_unlock(&table_lock);
+        release_buffer(&buffer, release, owned, NULL);
+        return slot < 0 ? ERR_FAIL : ERR_INVALID_SYSTEM_HANDLE;
+    }
+    Ngs2Rack *rack = &racks[slot];
+    memset(rack, 0, sizeof(*rack));
+    rack->used = 1;
+    rack->system = system_handle;
+    rack->rack_id = rack_id;
+    rack->max_voices = option->max_voices ? option->max_voices : 16;
+    if (rack->max_voices > MAX_VOICES) rack->max_voices = MAX_VOICES;
+    rack->max_matrices = option->max_matrices;
+    rack->max_ports = option->max_ports;
+    memcpy(rack->name, option->name, 16);
+    rack->name[16] = 0;
+    rack->buffer = buffer;
+    rack->host_free = release;
+    rack->owns_buffer = owned;
+    system->rack_count++;
+    *out_handle = MAKE_HANDLE(HANDLE_RACK, slot);
+    racks_created++;
+    uint32_t max_voices = rack->max_voices, max_matrices = rack->max_matrices,
+             max_ports = rack->max_ports;
+    pthread_mutex_unlock(&table_lock);
+    printf("Runtime: ngs2 rack created (rackId=%u maxVoices=%u maxMatrices=%u maxPorts=%u "
+           "buffer=%zu bytes)\n",
+           rack_id, max_voices, max_matrices, max_ports, buffer.host_buffer_size);
+    return 0;
+}
+static ABI int32_t ngs2_rack_destroy(uintptr_t handle, Ngs2BufferInfo *out_buffer) {
+    Ngs2BufferHandler release = NULL;
+    Ngs2BufferInfo buffer;
+    int owned = 0;
+    pthread_mutex_lock(&table_lock);
+    Ngs2Rack *rack = rack_of(handle);
+    if (!rack) {
+        pthread_mutex_unlock(&table_lock);
+        return ERR_INVALID_RACK_HANDLE;
+    }
+    for (size_t i = 0; i < MAX_VOICES; ++i)
+        if (voices[i].used && voices[i].rack == handle) voices[i].used = 0;
+    buffer = rack->buffer;
+    release = rack->host_free;
+    owned = rack->owns_buffer;
+    memset(rack, 0, sizeof(*rack));
+    pthread_mutex_unlock(&table_lock);
+    release_buffer(&buffer, release, owned, out_buffer);
+    return 0;
+}
+/* The voice handles belong to the rack: the game asks for each index once and reuses the handle. */
+static ABI int32_t ngs2_rack_get_voice_handle(uintptr_t handle, uint32_t voice_index,
+                                              uintptr_t *out_handle) {
+    int32_t error = 0;
+    int slot = -1;
+    if (!out_handle) return ERR_INVALID_OUT_ADDRESS;
+    pthread_mutex_lock(&table_lock);
+    Ngs2Rack *rack = rack_of(handle);
+    if (!rack) {
+        error = ERR_INVALID_RACK_HANDLE;
+    } else if (voice_index >= rack->max_voices) {
+        printf("Runtime: ngs2 rack voice %u is out of range (maxVoices=%u)\n", voice_index,
+               rack->max_voices);
+        error = ERR_INVALID_VOICE_HANDLE;
+    } else {
+        for (size_t i = 0; i < MAX_VOICES; ++i) {
+            if (voices[i].used && voices[i].rack == handle && voices[i].index == voice_index) {
+                slot = (int)i;
+                break;
+            }
+        }
+        if (slot < 0) slot = first_free(&voices[0].used, MAX_VOICES, sizeof(Ngs2Voice));
+        if (slot < 0) {
+            error = ERR_FAIL;
+        } else {
+            voices[slot].used = 1;
+            voices[slot].rack = handle;
+            voices[slot].index = voice_index;
+            voices_created++;
+            *out_handle = MAKE_HANDLE(HANDLE_VOICE, slot);
+        }
+    }
+    pthread_mutex_unlock(&table_lock);
+    return error;
+}
+
+/* The parameter list is a chain of OrbisNgs2VoiceParamHeader entries (size, offset to the next,
+ * id). Nothing is applied: the graph is silent, so a volume, matrix, envelope, waveform block or
+ * key-on has nothing to act on. The ids are counted so a log shows what the game asks for. */
+static ABI int32_t ngs2_voice_control(uintptr_t handle, const Ngs2ParamHeader *params) {
+    const char *cursor = (const char *)params;
+    uint32_t applied = 0, last_id = 0;
+    int32_t error = 0;
+    pthread_mutex_lock(&table_lock);
+    Ngs2Voice *voice = voice_of(handle);
+    if (!voice) {
+        error = ERR_INVALID_VOICE_HANDLE;
+    } else {
+        for (uint32_t i = 0; cursor && i < MAX_PARAMS; ++i) {
+            Ngs2ParamHeader header;
+            memcpy(&header, cursor, sizeof(header));
+            if (header.size < (uint16_t)sizeof(Ngs2ParamHeader)) break;
+            applied++;
+            last_id = header.id;
+            if (!header.next || header.next < (int16_t)header.size) break;
+            cursor += header.next;
+        }
+        if (params) {
+            voice->control_calls++;
+            control_calls++;
+            if (control_calls <= 4 || applied > 8)
+                printf("Runtime: ngs2 voice control (voice %u, %u params, last id 0x%x)\n",
+                       voice->index, applied, last_id);
+        }
+    }
+    pthread_mutex_unlock(&table_lock);
+    return error;
+}
+/* A voice is always idle: the graph plays nothing, so the game's voice pool recycles immediately
+ * instead of waiting for a sound that will never finish. */
+static ABI int32_t ngs2_voice_get_state(uintptr_t handle, Ngs2VoiceState *out_state,
+                                        size_t state_size) {
+    int32_t error = 0;
+    pthread_mutex_lock(&table_lock);
+    if (!voice_of(handle)) error = ERR_INVALID_VOICE_HANDLE;
+    pthread_mutex_unlock(&table_lock);
+    if (error) return error;
+    if (!out_state) return ERR_INVALID_OUT_ADDRESS;
+    if (state_size < sizeof(Ngs2VoiceState)) return ERR_INVALID_VOICE_STATE_SIZE;
+    memset(out_state, 0, state_size < sizeof(*out_state) ? state_size : sizeof(*out_state));
+    return 0;
+}
+static ABI int32_t ngs2_voice_get_state_flags(uintptr_t handle, uint32_t *out_flags) {
+    int32_t error = 0;
+    pthread_mutex_lock(&table_lock);
+    if (!voice_of(handle)) error = ERR_INVALID_VOICE_HANDLE;
+    pthread_mutex_unlock(&table_lock);
+    if (error) return error;
+    if (!out_flags) return ERR_INVALID_OUT_ADDRESS;
+    *out_flags = 0;
+    return 0;
+}
+/* The waveform the game parses is described back as empty (zero samples): the mixer plays nothing,
+ * so a sound built from it never renders. The first call's header is printed once, which is what
+ * identifies the container when a real decoder is added. */
+static ABI int32_t ngs2_parse_waveform_data(const void *data, size_t data_size,
+                                            Ngs2WaveformInfo *out_info) {
+    if (!out_info) return ERR_INVALID_OUT_ADDRESS;
+    memset(out_info, 0, sizeof(*out_info));
+    waveform_calls++;
+    if (waveform_calls == 1) {
+        const unsigned char *bytes = data;
+        char text[17];
+        size_t i, shown = 0;
+        for (i = 0; i < 16 && i < data_size; ++i) {
+            unsigned char c = bytes[i];
+            text[i] = (c >= 0x20 && c < 0x7f) ? (char)c : '.';
+        }
+        text[i] = 0;
+        shown = i;
+        printf("Runtime: ngs2 waveform parse: %zu bytes, header \"%s\" (%02x %02x %02x %02x %02x "
+               "%02x %02x %02x), reported as empty\n",
+               data_size, text, shown > 0 ? bytes[0] : 0, shown > 1 ? bytes[1] : 0,
+               shown > 2 ? bytes[2] : 0, shown > 3 ? bytes[3] : 0, shown > 4 ? bytes[4] : 0,
+               shown > 5 ? bytes[5] : 0, shown > 6 ? bytes[6] : 0, shown > 7 ? bytes[7] : 0);
+    }
+    return 0;
+}
+
+static const RuntimeExport exports[] = {
+    {"sceNgs2SystemCreateWithAllocator", ngs2_system_create_with_allocator},
+    {"sceNgs2SystemDestroy", ngs2_system_destroy},
+    {"sceNgs2SystemSetSampleRate", ngs2_system_set_sample_rate},
+    {"sceNgs2SystemSetGrainSamples", ngs2_system_set_grain_samples},
+    {"sceNgs2SystemRender", ngs2_system_render},
+    {"sceNgs2RackCreateWithAllocator", ngs2_rack_create_with_allocator},
+    {"sceNgs2RackDestroy", ngs2_rack_destroy},
+    {"sceNgs2RackGetVoiceHandle", ngs2_rack_get_voice_handle},
+    {"sceNgs2VoiceControl", ngs2_voice_control},
+    {"sceNgs2VoiceGetState", ngs2_voice_get_state},
+    {"sceNgs2VoiceGetStateFlags", ngs2_voice_get_state_flags},
+    {"sceNgs2ParseWaveformData", ngs2_parse_waveform_data},
+};
+uintptr_t runtime_ngs2_resolve(const char *name) {
+    const uintptr_t symbol = RUNTIME_LOOKUP(exports, name);
+    if (symbol) return symbol;
+    /* import_names.inc was generated from another title and has no libSceNgs2 entry, so the twelve
+     * NIDs CUSA02716 imports (index 241..253 of analysis.json's import list) are bound by NID.
+     * runtime_key_match compares the eleven NID characters, so the `#library#module` suffix this
+     * image spells (`#1#v`) does not matter. */
+    if (runtime_key_match(name, "hyVLT2VlOYk#")) return (uintptr_t)ngs2_parse_waveform_data;
+    if (runtime_key_match(name, "uu94irFOGpA#")) return (uintptr_t)ngs2_voice_control;
+    if (runtime_key_match(name, "rEh728kXk3w#")) return (uintptr_t)ngs2_voice_get_state_flags;
+    if (runtime_key_match(name, "-TOuuAQ-buE#")) return (uintptr_t)ngs2_voice_get_state;
+    if (runtime_key_match(name, "i0VnXM-C9fc#")) return (uintptr_t)ngs2_system_render;
+    if (runtime_key_match(name, "mPYgU4oYpuY#")) return (uintptr_t)ngs2_system_create_with_allocator;
+    if (runtime_key_match(name, "U546k6orxQo#")) return (uintptr_t)ngs2_rack_create_with_allocator;
+    if (runtime_key_match(name, "MwmHz8pAdAo#")) return (uintptr_t)ngs2_rack_get_voice_handle;
+    if (runtime_key_match(name, "-tbc2SxQD60#")) return (uintptr_t)ngs2_system_set_sample_rate;
+    if (runtime_key_match(name, "l4Q2dWEH6UM#")) return (uintptr_t)ngs2_system_set_grain_samples;
+    if (runtime_key_match(name, "lCqD7oycmIM#")) return (uintptr_t)ngs2_rack_destroy;
+    if (runtime_key_match(name, "u-WrYDaJA3k#")) return (uintptr_t)ngs2_system_destroy;
+    return 0;
+}
+void runtime_ngs2_report(void) {
+    printf("Runtime: ngs2 systems=%zu racks=%zu voices=%zu control=%zu renders=%zu grains=%zu "
+           "waveforms=%zu render errors=%zu",
+           systems_created, racks_created, voices_created, control_calls, render_calls, grains,
+           waveform_calls, render_errors);
+    if (render_calls)
+        printf(" (last render: %u buffers, %u bytes, type %u, %u channels)", last_render_buffers,
+               last_render_size, last_render_type, last_render_channels);
+    printf("\n");
+}
diff --git a/src/runtime_platform.c b/src/runtime_platform.c
new file mode 100644
index 0000000..6a1d855
--- /dev/null
+++ b/src/runtime_platform.c
@@ -0,0 +1,83 @@
+/* The platform subsystems this title initialises at startup that a phone does not have: USB mass
+ * storage, the screenshot / video-recording flags, SharePlay, live streaming. Every one of them is a
+ * setting or a query with no device behind it, so each call is accepted and nothing is reported -
+ * which is what the hardware library answers when there is no USB device, no share target and no
+ * streaming service. The functions keep their own names in the report so a log shows which
+ * subsystems the game actually touches; a call that needs an output buffer is not accepted here and
+ * stays unimplemented (the runtime lists it at startup, see probe.c).
+ *
+ * The fourteen imports CUSA02716 makes of these libraries before its main loop: analysis.json
+ * indexes 288, 289, 290, 291, 292, 293, 627, 628, 629, 630 (and the dialog libraries, which are
+ * left out on purpose: an unanswered dialog would block a caller that waits for FINISHED). */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#define MAX_NOTED 16
+static pthread_mutex_t note_lock = PTHREAD_MUTEX_INITIALIZER;
+static size_t stub_calls;
+static const char *stub_names[MAX_NOTED];
+
+static void platform_note(const char *name) {
+    pthread_mutex_lock(&note_lock);
+    if (stub_calls < MAX_NOTED) stub_names[stub_calls] = name;
+    stub_calls++;
+    pthread_mutex_unlock(&note_lock);
+}
+
+/* An accepted call with no effect and no out-parameter. Any argument the caller passes is ignored,
+ * so one shape serves the one-argument and the no-argument entry points alike. */
+#define PLATFORM_ACCEPT(name)                                              \
+    static ABI int32_t name(uintptr_t argument0, uintptr_t argument1) {    \
+        (void)argument0;                                                   \
+        (void)argument1;                                                   \
+        platform_note(#name);                                              \
+        return 0;                                                          \
+    }
+
+PLATFORM_ACCEPT(usb_storage_init)          /* sceUsbStorageInit(const SceUsbStorageParam*) */
+PLATFORM_ACCEPT(usb_storage_term)          /* sceUsbStorageTerm(void) */
+PLATFORM_ACCEPT(usb_storage_register)      /* sceUsbStorageRegisterCallback(callback) */
+PLATFORM_ACCEPT(usb_storage_unregister)    /* sceUsbStorageUnregisterCallback(void) */
+PLATFORM_ACCEPT(screen_shot_enable)        /* sceScreenShotEnable(void) */
+PLATFORM_ACCEPT(screen_shot_disable)       /* sceScreenShotDisable(void) */
+PLATFORM_ACCEPT(video_recording_info)      /* sceVideoRecordingSetInfo(const SceVideoRecordingInfo*) */
+PLATFORM_ACCEPT(share_play_init)           /* sceSharePlayInitialize(void) */
+PLATFORM_ACCEPT(share_play_prohibition)    /* sceSharePlaySetProhibition(int) */
+PLATFORM_ACCEPT(live_streaming_init)       /* sceGameLiveStreamingInitialize(void) */
+PLATFORM_ACCEPT(live_streaming_enable)     /* sceGameLiveStreamingEnableLiveStreaming(int) */
+
+uintptr_t runtime_platform_resolve(const char *name) {
+    /* The names are the PS4 ones: import_names.inc was generated from another title and has no entry
+     * for these NIDs, so the binding is by NID (runtime_key_match compares the eleven NID
+     * characters only, whatever `#library#module` suffix this image spells). */
+    if (runtime_key_match(name, "BDDZwF5kuTc#")) return (uintptr_t)usb_storage_init;
+    if (runtime_key_match(name, "Wp8zHTocS5E#")) return (uintptr_t)usb_storage_term;
+    if (runtime_key_match(name, "vFkdkzJgSpw#")) return (uintptr_t)usb_storage_register;
+    if (runtime_key_match(name, "+Ib-MHNUf80#")) return (uintptr_t)usb_storage_unregister;
+    if (runtime_key_match(name, "2xxUtuC-RzE#")) return (uintptr_t)screen_shot_enable;
+    if (runtime_key_match(name, "tIYf0W5VTi8#")) return (uintptr_t)screen_shot_disable;
+    if (runtime_key_match(name, "Fc8qxlKINYQ#")) return (uintptr_t)video_recording_info;
+    if (runtime_key_match(name, "isruqthpYcw#")) return (uintptr_t)share_play_init;
+    if (runtime_key_match(name, "co2NCj--pnc#")) return (uintptr_t)share_play_prohibition;
+    if (runtime_key_match(name, "kvYEw2lBndk#")) return (uintptr_t)live_streaming_init;
+    if (runtime_key_match(name, "dWM80AX39o4#")) return (uintptr_t)live_streaming_enable;
+    return 0;
+}
+void runtime_platform_report(void) {
+    pthread_mutex_lock(&note_lock);
+    const size_t calls = stub_calls;
+    pthread_mutex_unlock(&note_lock);
+    if (!calls) {
+        printf("Runtime: platform stubs not called\n");
+        return;
+    }
+    printf("Runtime: platform stubs accepted %zu calls", calls);
+    for (size_t i = 0; i < MAX_NOTED; ++i) {
+        if (!stub_names[i]) break;
+        printf("%s%s", i ? ", " : " (", stub_names[i]);
+    }
+    printf(")\n");
+}
