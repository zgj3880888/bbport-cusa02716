+static ABI int guest_strcpy_s(char *dest, size_t dest_size, const char *source) {
+    size_t length;
+    if (!dest || !dest_size) return 22;
+    if (!source) { dest[0] = 0; return 22; }
+    length = strlen(source);
+    if (length + 1 > dest_size) { dest[0] = 0; return 34; }
+    memcpy(dest, source, length + 1);
+    return 0;
