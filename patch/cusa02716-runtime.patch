+    if (!take_digits(text+11,2,&value)) return (int32_t)0x80B50003;
+    t.hour=(uint16_t)value;
+    if (!take_digits(text+14,2,&value)) return (int32_t)0x80B50003;
+    t.minute=(uint16_t)value;
+    if (!take_digits(text+17,2,&value)) return (int32_t)0x80B50003;
+    t.second=(uint16_t)value;
+    if (!take_digits(text+20,4,&value)) return (int32_t)0x80B50003;
+    t.year=(uint16_t)value;
