+    if (used >= dest_size) { dest[0] = 0; return 22; }   /* unterminated destination */
+    if (!source) { dest[0] = 0; return 22; }
+    length = strlen(source);
+    if (used + length + 1 > dest_size) { dest[0] = 0; return 34; }
+    memcpy(dest + used, source, length + 1);
+    return 0;
