+/* A guest memory read for the report: a frame pointer that points nowhere must not fault the
+ * handler a second time (process_vm_readv reports EFAULT instead). */
+static int fault_guest_read(uintptr_t at, void *out, size_t size) {
+#if defined(__linux__)
+    struct iovec local = {out, size}, remote = {(void *)at, size};
+    return process_vm_readv(getpid(), &local, 1, &remote, 1, 0) == (ssize_t)size;
+#else
+    (void)at; (void)out; (void)size;
+    return 0;
+#endif
+}
+/* Writes the first `n` bytes of `line` as one line. */
+static void fault_line(char *line, size_t n) {
+    line[n++] = '\n';
+    line[n] = 0;
+    ssize_t written_ = write(2, line, n);
+    (void)written_;
+}
+/* A word of guest memory for the report; 0 when it cannot be read. */
+static int fault_guest_word(uint64_t at, uint64_t *out) {
+    *out = 0;
+    return at && fault_guest_read((uintptr_t)at, out, sizeof(*out));
+}
+/* The string `at` points at, when it is one: four or more printable bytes ending in a NUL. */
+static int fault_text_at(uint64_t at, char *out, size_t size) {
+    char buffer[64];
+    size_t limit = size - 1 < sizeof(buffer) - 1 ? size - 1 : sizeof(buffer) - 1, i = 0;
+    out[0] = 0;
+    if (at < (uint64_t)(uintptr_t)image) return 0;
+    if (!fault_guest_read((uintptr_t)at, buffer, limit)) return 0;
+    while (i < limit && buffer[i]) {
+        if (buffer[i] < 0x20 || buffer[i] > 0x7e) return 0;
+        ++i;
+    }
+    if (i < 4) return 0;
+    memcpy(out, buffer, i);
+    out[i] = 0;
+    return 1;
+}
+/* CUSA02716's elSeq manager, the list the two walks in the crash read.
+ *
+ * The image holds the manager's address at 0xC50608 (`lea rax, [rip + 0x9950a0]` at 0x2bb561);
+ * +0x20 is the last id handed out, +0x30 and +0x38 the vector of players. A player keeps the
+ * resource it loaded at +0xe0 and the elSeq that resource created at +0xe8, whose id sits at
+ * +0x108: 0x2bb550 (assigning an id) and 0x2bd460 (looking one up) both read
+ * [[player + 0xe8] + 0x108] with no null check, so one player built around a load that produced
+ * no elSeq turns the next sequence the game creates into a fault at 0x108. The dump names that
+ * player, the resource it asked for, and what the load left in the resource's flags (+0x20). */
+enum { ELSEQ_MANAGER_OFFSET = 0xc50608, ELSEQ_PRINTED = 40 };
+/* Sixteen bytes a line with the printable ones beside them: a class that keeps its name inline
+ * (a short std::string lives in the object, not behind a pointer) has nothing the pointer walk
+ * below can follow. */
+static void fault_dump_bytes(const char *label, uint64_t at, size_t size) {
+    unsigned char bytes[64];
+    char line[200], ascii[17];
+    if (size > sizeof(bytes)) size = sizeof(bytes);
+    if (!at || !fault_guest_read((uintptr_t)at, bytes, size)) return;
+    for (size_t base = 0; base < size; base += 16) {
+        size_t n = size - base < 16 ? size - base : 16, p = 0, k = 0;
+        p += (size_t)snprintf(line, sizeof(line), "    %s+%#04x ", label, (unsigned)base);
+        for (size_t i = 0; i < 16; ++i) {
+            if (i < n) p += (size_t)snprintf(line + p, sizeof(line) - p, "%02x ", bytes[base + i]);
+            else p += (size_t)snprintf(line + p, sizeof(line) - p, "   ");
+            ascii[k++] = i < n && bytes[base + i] >= 0x20 && bytes[base + i] < 0x7f
+                             ? (char)bytes[base + i] : '.';
+        }
+        ascii[k] = 0;
+        p += (size_t)snprintf(line + p, sizeof(line) - p, " |%s|", ascii);
+        fault_line(line, p);
+    }
+}
+/* The strings the guest stack still holds.
+ *
+ * A resource is loaded by name, and the name is an operand of the script VM frame that asked
+ * for it: that frame is still on the stack under the fault. When the load returned nothing,
+ * the resource object holds no name to print, and the stack is the only place left that says
+ * which file the game wanted. */
+static void fault_dump_stack_strings(uint64_t rsp) {
+    char line[160], text[48];
+    uint64_t seen[24];
+    int seen_count = 0, shown = 0;
+    for (uint64_t at = (rsp + 7) & ~(uint64_t)7; shown < 20 && at < rsp + 0x3000; at += 8) {
+        uint64_t value = 0;
+        if (!fault_guest_word(at, &value) || !value) continue;
+        if (!fault_text_at(value, text, sizeof(text))) continue;
+        int repeated = 0;
+        for (int i = 0; i < seen_count; ++i) if (seen[i] == value) repeated = 1;
+        if (repeated) continue;
+        if (seen_count < (int)(sizeof(seen) / sizeof(seen[0]))) seen[seen_count++] = value;
+        size_t n = (size_t)snprintf(line, sizeof(line), "  stack +%#06lx -> \"%s\"",
+                                    (unsigned long)(at - rsp), text);
+        fault_line(line, n);
+        ++shown;
+    }
+}
+static void fault_dump_elseq(void) {
+    char line[320], text[56];
+    uint64_t manager = 0, head = 0, tail = 0, last = 0;
+    int dumped_healthy = 0, broken_dumped = 0;
