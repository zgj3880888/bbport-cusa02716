new file mode 100644
index 0000000..a60167f
--- /dev/null
+++ b/src/runtime_ngs2.c
@@ -0,0 +1,664 @@
+/* libSceNgs2: the audio render graph. CUSA02716 imports exactly twelve of its functions, and they
+ * are a closed set: create a system and a rack from memory the game allocates itself, hand out the
+ * rack's voice handles, set the sample rate and the grain size, control the voices, read their
+ * state, render one grain per call, destroy. This backend owns that state and is silent: it zeroes
+ * every output buffer it is handed, so the game's mixer thread runs at its own pace and the audio
+ * port opened by runtime_audio.c (which the game feeds from these buffers) carries silence.
+ *
+ * No DSP graph is emulated (no sampler, envelope, reverb, matrix or codec work), so the game has
+ * no sound. Everything the game can observe through this API stays consistent: handles are valid
+ * for their lifetime, the game's own alloc/free callbacks are called exactly as the hardware
+ * library calls them (the game keeps ownership of the memory), a voice is always reported idle, so
+ * a voice pool never runs dry and no caller waits for a sound to finish.
+ *
+ * The stop this replaces was `first unsupported PS4 import: mPYgU4oYpuY#1#v` (index 247,
+ * sceNgs2SystemCreateWithAllocator) at caller offset 0x2d8a28. */
+#define _GNU_SOURCE
+#include "runtime.h"
+#include "guest_cpu.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+
+#define ERR_FAIL                     ((int32_t)0x804A0001)
+#define ERR_INVALID_OPTION_ADDRESS   ((int32_t)0x804A0080)
+#define ERR_INVALID_OPTION_SIZE      ((int32_t)0x804A0081)
+#define ERR_INVALID_OUT_ADDRESS      ((int32_t)0x804A0053)
+#define ERR_INVALID_BUFFER_INFO      ((int32_t)0x804A0206)
+#define ERR_INVALID_BUFFER_SIZE      ((int32_t)0x804A0209)
+#define ERR_INVALID_BUFFER_ALLOCATOR ((int32_t)0x804A020A)
+#define ERR_INVALID_SYSTEM_HANDLE    ((int32_t)0x804A0230)
+#define ERR_INVALID_RACK_HANDLE      ((int32_t)0x804A0261)
+#define ERR_INVALID_VOICE_HANDLE     ((int32_t)0x804A0300)
+#define ERR_INVALID_VOICE_STATE_SIZE ((int32_t)0x804A0A06)
+
+#define MAX_SYSTEMS 8
+#define MAX_RACKS 32
+#define MAX_VOICES 256
+#define MAX_PARAMS 64
+#define MAX_ZERO_BYTES (4u << 20) /* never zero more than this per buffer, whatever the game says */
+
+/* Handles are opaque to the game; a tag keeps a stray value from being mistaken for one. */
+#define HANDLE_TAG 0x4E470000u
+enum { HANDLE_SYSTEM = 1, HANDLE_RACK = 2, HANDLE_VOICE = 3 };
+#define MAKE_HANDLE(type, index) ((uintptr_t)(HANDLE_TAG | ((uint32_t)(type) << 12) | (uint32_t)(index)))
+#define HANDLE_TYPE(handle) (((uintptr_t)(handle) & 0xF000u) >> 12)
+#define HANDLE_INDEX(handle) ((uintptr_t)(handle) & 0xFFFu)
+#define HANDLE_VALID(handle, type, index) \
+    (((uintptr_t)(handle) & 0xFFFF0000u) == HANDLE_TAG && HANDLE_TYPE(handle) == (type) && \
+     HANDLE_INDEX(handle) == (uintptr_t)(index))
+
+typedef struct { /* OrbisNgs2ContextBufferInfo: what the game's allocator fills in and gets back */
+    void *host_buffer;
+    size_t host_buffer_size;
+    uintptr_t reserved[5];
+    uintptr_t user_data;
+} Ngs2BufferInfo;
+
+typedef struct { /* OrbisNgs2SystemOption */
+    size_t size;
+    char name[16];
+    uint32_t flags;
+    uint32_t max_grain_samples;
+    uint32_t num_grain_samples;
+    uint32_t sample_rate;
+    uint32_t reserved[6];
+} Ngs2SystemOption;
+
+typedef struct { /* OrbisNgs2RackOption */
+    size_t size;
+    char name[16];
+    uint32_t flags;
+    uint32_t max_grain_samples;
+    uint32_t max_voices;
+    uint32_t max_input_delay_blocks;
+    uint32_t max_matrices;
+    uint32_t max_ports;
+    uint32_t reserved[20];
+} Ngs2RackOption;
+
+typedef struct { /* OrbisNgs2RenderBufferInfo */
+    void *buffer;
+    size_t buffer_size;
+    uint32_t waveform_type; /* 0 s16, 1 s32, 2 float, as in the AJM decoder in runtime_ajm.c */
+    uint32_t num_channels;
+} Ngs2RenderBuffer;
+
+typedef struct { /* OrbisNgs2VoiceParamHeader: a linked list of parameters */
+    uint16_t size;
+    int16_t next; /* offset from this entry to the next, 0: last */
+    uint32_t id;
+} Ngs2ParamHeader;
+
+typedef struct { /* OrbisNgs2WaveformFormat */
+    uint32_t waveform_type;
+    uint32_t num_channels;
+    uint32_t sample_rate;
+    uint32_t config_data;
+    uint32_t frame_offset;
+    uint32_t frame_margin;
+} Ngs2WaveformFormat;
+
+typedef struct { /* OrbisNgs2WaveformBlock */
+    uint32_t data_offset;
+    uint32_t data_size;
+    uint32_t num_repeats;
+    uint32_t num_skip_samples;
+    uint32_t num_samples;
+    uint32_t reserved;
+    uintptr_t user_data;
+} Ngs2WaveformBlock;
+
+typedef struct { /* OrbisNgs2WaveformInfo */
+    Ngs2WaveformFormat format;
+    uint32_t data_offset;
+    uint32_t data_size;
+    uint32_t loop_begin_position;
+    uint32_t loop_end_position;
+    uint32_t num_samples;
+    uint32_t audio_unit_size;
+    uint32_t num_audio_unit_samples;
+    uint32_t num_audio_unit_per_frame;
+    uint32_t audio_frame_size;
+    uint32_t num_audio_frame_samples;
+    uint32_t num_delay_samples;
+    uint32_t num_blocks;
+    Ngs2WaveformBlock block[4];
+} Ngs2WaveformInfo;
+
+typedef struct { /* OrbisNgs2VoiceState */
+    uint32_t state_flags;
+} Ngs2VoiceState;
+
+_Static_assert(sizeof(Ngs2BufferInfo) == 64, "OrbisNgs2ContextBufferInfo layout");
+_Static_assert(sizeof(Ngs2SystemOption) == 64, "OrbisNgs2SystemOption layout");
+_Static_assert(sizeof(Ngs2RackOption) == 128, "OrbisNgs2RackOption layout");
+_Static_assert(sizeof(Ngs2RenderBuffer) == 24, "OrbisNgs2RenderBufferInfo layout");
+_Static_assert(sizeof(Ngs2ParamHeader) == 8, "OrbisNgs2VoiceParamHeader layout");
+_Static_assert(sizeof(Ngs2WaveformInfo) == 200, "OrbisNgs2WaveformInfo layout");
+
+typedef int32_t(ABI *Ngs2BufferHandler)(Ngs2BufferInfo *info);
+
+/* The game's handlers are guest code: on AArch64 they exist only as recompiled units, so the call
+ * has to go through the guest CPU's dispatcher (guest_cpu.h), never through the raw pointer.
+ * Called from inside the guest's own call into this file, so it runs on the guest stack. */
+static int32_t call_buffer_handler(Ngs2BufferHandler handler, Ngs2BufferInfo *info) {
+    const uint64_t argument = (uint64_t)(uintptr_t)info;
+    return (int32_t)guest_cpu_call((uintptr_t)handler, 1, &argument);
+}
+
+typedef struct { /* OrbisNgs2BufferAllocator: the game's own alloc/free pair */
+    Ngs2BufferHandler alloc_handler;
+    Ngs2BufferHandler free_handler;
+    uintptr_t user_data;
+} Ngs2Allocator;
+
+_Static_assert(sizeof(Ngs2Allocator) == 24, "OrbisNgs2BufferAllocator layout");
+
+typedef struct {
+    int used;
+    uint32_t sample_rate, grain_samples, max_grain_samples;
+    char name[17];
+    Ngs2BufferInfo buffer;      /* what the game's allocator handed over */
+    Ngs2BufferHandler host_free;
+    int owns_buffer;            /* no allocator: the buffer is this file's malloc */
+    size_t rack_count;
+} Ngs2System;
+
+typedef struct {
+    int used;
+    uintptr_t system;           /* owning system handle */
+    uint32_t max_voices, max_matrices, max_ports, rack_id;
+    char name[17];
+    Ngs2BufferInfo buffer;
+    Ngs2BufferHandler host_free;
+    int owns_buffer;
+} Ngs2Rack;
+
+typedef struct {
+    int used;
+    uintptr_t rack;
+    uint32_t index;
+    uint64_t control_calls;
+} Ngs2Voice;
+
+static pthread_mutex_t table_lock = PTHREAD_MUTEX_INITIALIZER;
+static Ngs2System systems[MAX_SYSTEMS];
+static Ngs2Rack racks[MAX_RACKS];
+static Ngs2Voice voices[MAX_VOICES];
+static size_t systems_created, racks_created, voices_created, control_calls, render_calls, grains;
+static size_t render_errors, waveform_calls;
+static uint32_t last_render_buffers, last_render_size, last_render_type, last_render_channels;
+
+static Ngs2System *system_of(uintptr_t handle) {
+    size_t index;
+    if (HANDLE_TYPE(handle) != HANDLE_SYSTEM) return NULL;
+    index = (size_t)HANDLE_INDEX(handle);
+    if (index >= MAX_SYSTEMS || !systems[index].used) return NULL;
+    if (!HANDLE_VALID(handle, HANDLE_SYSTEM, index)) return NULL;
+    return &systems[index];
+}
+static Ngs2Rack *rack_of(uintptr_t handle) {
+    size_t index;
+    if (HANDLE_TYPE(handle) != HANDLE_RACK) return NULL;
+    index = (size_t)HANDLE_INDEX(handle);
+    if (index >= MAX_RACKS || !racks[index].used) return NULL;
+    if (!HANDLE_VALID(handle, HANDLE_RACK, index)) return NULL;
+    return &racks[index];
+}
+static Ngs2Voice *voice_of(uintptr_t handle) {
+    size_t index;
+    if (HANDLE_TYPE(handle) != HANDLE_VOICE) return NULL;
+    index = (size_t)HANDLE_INDEX(handle);
+    if (index >= MAX_VOICES || !voices[index].used) return NULL;
+    if (!HANDLE_VALID(handle, HANDLE_VOICE, index)) return NULL;
+    return &voices[index];
+}
+static int first_free(int *used, size_t count, size_t stride) {
+    for (size_t i = 0; i < count; ++i)
+        if (!*(int *)((char *)used + i * stride)) return (int)i;
+    return -1;
+}
+
+/* The size the hardware library would ask the game's allocator for. The game mallocs this and owns
+ * it, so it only has to be plausible and small: asking for more than the game's pool holds would
+ * make its own allocator fail the whole create. */
+static size_t system_buffer_size(const Ngs2SystemOption *option) {
+    size_t grain = option->max_grain_samples ? option->max_grain_samples : 256;
+    if (grain > 8192) grain = 8192;
+    return 65536 + grain * 64;
+}
+static size_t rack_buffer_size(const Ngs2RackOption *option) {
+    size_t per_voice = 4096 + (option->max_ports ? option->max_ports : 4) * 64;
+    size_t size = 65536 + (option->max_voices ? option->max_voices : 16) * per_voice;
+    if (size > (2u << 20)) size = 2u << 20;
+    return size;
+}
+/* Asks the game's allocator for the memory, or takes this process's own when there is none: the
+ * game's free callback never sees a pointer it does not own. Returns 0 or a Ngs2 error. */
+static int32_t acquire_buffer(size_t size, const Ngs2Allocator *allocator, Ngs2BufferInfo *out,
+                              Ngs2BufferHandler *out_free, int *out_owned) {
+    Ngs2BufferHandler alloc = NULL, release = NULL;
+    memset(out, 0, sizeof(*out));
+    out->host_buffer_size = size;
+    *out_free = NULL;
+    *out_owned = 0;
+    if (allocator) {
+        alloc = allocator->alloc_handler;
+        release = allocator->free_handler;
+        out->user_data = allocator->user_data;
+    }
+    if (!alloc) {
+        /* No allocator: take our own memory and free it here, so a game that only ever used the
+         * WithAllocator entry points still gets a working system. */
+        out->host_buffer = malloc(size);
+        if (!out->host_buffer) return ERR_FAIL;
+        *out_owned = 1;
+        return 0;
+    }
+    if (call_buffer_handler(alloc, out) < 0) {
+        /* The game's own allocator refused; it owns whatever it left in host_buffer, so this file
+         * never frees it (host free() on guest memory would corrupt the heap). */
+        memset(out, 0, sizeof(*out));
+        return ERR_INVALID_BUFFER_ALLOCATOR;
+    }
+    if (!out->host_buffer || out->host_buffer_size < size) {
+        if (out->host_buffer && release) call_buffer_handler(release, out);
+        memset(out, 0, sizeof(*out));
+        return ERR_INVALID_BUFFER_SIZE;
+    }
+    *out_free = release;
+    return 0;
+}
+static void release_buffer(Ngs2BufferInfo *buffer, Ngs2BufferHandler release, int owned,
+                           Ngs2BufferInfo *out) {
+    if (out) *out = *buffer; /* the game frees what its own allocator handed over */
+    if (owned) {
+        free(buffer->host_buffer);
+        if (out) {
+            out->host_buffer = NULL;
+            out->host_buffer_size = 0;
+        }
+    } else if (release) {
+        call_buffer_handler(release, buffer);
+        if (out) {
+            out->host_buffer = NULL;
+            out->host_buffer_size = 0;
+        }
+    }
+    memset(buffer, 0, sizeof(*buffer));
+}
+
+static ABI int32_t ngs2_system_create_with_allocator(const Ngs2SystemOption *option,
+                                                     const Ngs2Allocator *allocator, uintptr_t *out_handle) {
+    Ngs2BufferInfo buffer;
